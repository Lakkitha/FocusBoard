{
  "name": "focusboard",
  "version": "1.0.0",
  "description": "Personal productivity dashboard for focused goal tracking",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "electron": "electron .",
    "dist": "vite build && electron-packager . FocusBoard --platform=win32 --arch=x64 --out=dist-electron --overwrite --ignore=dist-electron --ignore=node_modules/.cache",
    "shortcut": "powershell -Command \"$ws = New-Object -ComObject WScript.Shell; $s = $ws.CreateShortcut([Environment]::GetFolderPath('Desktop') + '\\\\FocusBoard.lnk'); $s.TargetPath = (Resolve-Path 'dist-electron\\\\FocusBoard-win32-x64\\\\FocusBoard.exe').Path; $s.WorkingDirectory = (Resolve-Path 'dist-electron\\\\FocusBoard-win32-x64').Path; $s.Description = 'FocusBoard - Personal Productivity Dashboard'; $s.Save(); Write-Host 'Desktop shortcut created!'\"",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.focusboard.app",
    "productName": "FocusBoard",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
